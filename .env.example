# ============================================
# YouTube Knowledge Assistant - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenAI API Key (required) → gpt-4o-mini LLM + text-embedding-3-small embeddings
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# YouTube Data API v3 (optional — enables comment sentiment analysis)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# Optional: LangSmith tracing (recommended for development)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=youtube-knowledge-assistant
